# TECH CONNECT WiFi Billing System - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
DATABASE_URL=postgresql://username:password@host:port/database_name

# ==============================================
# M-PESA CONFIGURATION (PRODUCTION)
# ==============================================
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=your_mpesa_consumer_key_here
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret_here
MPESA_BUSINESS_SHORTCODE=your_business_shortcode
MPESA_PASSKEY=your_mpesa_passkey_here
MPESA_TILL_NUMBER=your_till_number
MPESA_CALLBACK_URL=https://yourdomain.com/backend/callback.php

# ==============================================
# ADMIN PANEL SECURITY
# ==============================================
ADMIN_SECRET_KEY=your_very_secure_admin_key_here_min_32_chars

# ==============================================
# SECURITY CONFIGURATION  
# ==============================================
ALLOWED_ORIGINS=https://yourdomain.com

# ==============================================
# BUSINESS CONFIGURATION (OPTIONAL)
# ==============================================
# BUSINESS_NAME=TECH CONNECT WiFi
# CUSTOMER_CARE_PHONE=your_customer_care_number

# ==============================================
# DEPLOYMENT INSTRUCTIONS
# ==============================================
# 
# IN PRODUCTION:
# 1. Set these variables in your host's environment settings
# 2. Never upload the .env file itself
# 3. Keep the variable names exactly as shown above
#
# FOR LOCAL DEVELOPMENT:
# 1. Copy this file to .env
# 2. Fill in your actual values
# 3. Make sure .env is in .gitignore
#